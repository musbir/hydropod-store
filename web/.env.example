# ---------------------------------------------------------------------------
# Copy to .env.local (development) or set in your hosting provider (production).
# ---------------------------------------------------------------------------

# Public base URL, used for canonical tags, OpenGraph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-store.example

# Merchant dashboard shared secret. Required for any write to /api/admin/*.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# --- Persistence -----------------------------------------------------------
# Leave DATABASE_URL empty to use the JSON/in-memory driver (demo only:
# merchant edits and orders are NOT durable on serverless).
# Set it to a PostgreSQL connection string for real persistence.
DATABASE_URL=
# Directory for the JSON driver's snapshot when DATABASE_URL is unset.
DATA_DIR=.data

# --- Payments --------------------------------------------------------------
# Each gateway stays in clearly-labelled "demo mode" until its keys are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

UPI_VPA=
UPI_PAYEE_NAME=

PAYTM_MID=
PAYTM_MERCHANT_KEY=
